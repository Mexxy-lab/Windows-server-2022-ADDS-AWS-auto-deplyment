
pipeline {

    // Run on the Jenkins agent with Terraform, AWS CLI, Ansible,
    // Trivy, and the SonarQube Scanner available.
    agent any

    options {
        // Include timestamps in build logs.
        timestamps()

        // Prevent simultaneous AWS AD deployments.
        disableConcurrentBuilds()

        // Allow sufficient time for Windows provisioning and AD configuration.
        timeout(time: 4, unit: 'HOURS')
    }

    environment {
        // Run Terraform in automation mode.
        TF_IN_AUTOMATION = 'true'

        // Set the AWS deployment region.
        AWS_DEFAULT_REGION = 'us-east-1'

        // Use the shared Ansible virtual environment.
        PATH = "/opt/jenkins-tools/ansible/bin:/usr/local/bin:/usr/bin:/bin:${env.PATH}"
    }

    stages {

        // --------------------------------------------------
        // 1. Checkout AWS AD Lab repository
        // --------------------------------------------------

        stage('SCM Checkout') {
            steps {
                checkout scm

                sh '''
                    set -e

                    echo "AWS Windows Server 2022 AD DS Deployment"
                    echo "=========================================="

                    # Display the checked-out commit.
                    git log -1 --oneline

                    # Confirm the repository root.
                    pwd
                '''
            }
        }

        // --------------------------------------------------
        // 2. Validate deployment script and prerequisites
        // --------------------------------------------------

        stage('Pre-deployment Validation') {
            steps {
                sh '''
                    set -e

                    echo "=========================================="
                    echo "Pre-deployment validation"
                    echo "=========================================="

                    # Confirm the AWS deployment script exists.
                    test -f startupadds-aws.sh

                    # Validate Bash syntax without running deployment.
                    bash -n startupadds-aws.sh

                    # Confirm the Terraform configuration exists.
                    test -f aws-ad-lab-terraform/main.tf
                    test -f aws-ad-lab-terraform/versions.tf

                    # Confirm required automation tools are installed.
                    for cmd in terraform aws ansible-playbook \
                               ansible ansible-inventory ansible-vault \
                               ansible-galaxy python3 session-manager-plugin \
                               trivy git; do

                        command -v "$cmd" >/dev/null 2>&1 || {
                            echo "ERROR: Missing required command: $cmd"
                            exit 1
                        }
                    done

                    # Display installed tool versions for traceability.
                    terraform version
                    aws --version
                    ansible --version
                    trivy version
                    session-manager-plugin --version

                    echo "All required tools are available."
                    echo "Pre-deployment validation passed."
                '''
            }
        }

        // --------------------------------------------------
        // 3. Trivy filesystem security scan
        // --------------------------------------------------

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    set -e

                    echo "=========================================="
                    echo "Trivy filesystem security scan"
                    echo "=========================================="

                    # Scan the repository for vulnerable dependencies
                    # and exposed secrets.
                    #
                    # Fail the pipeline on HIGH or CRITICAL findings.
                    trivy fs \
                        --scanners vuln,secret \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --format table \
                        --skip-dirs .git \
                        --skip-dirs .venv \
                        --skip-dirs logs \
                        --skip-dirs .terraform \
                        --skip-dirs .ansible \
                        .

                    echo "=========================================="
                    echo "Trivy Terraform IaC security scan"
                    echo "=========================================="

                    # Scan Terraform configuration for infrastructure
                    # misconfigurations.
                    #
                    # Restrict the misconfiguration scanner to Terraform.
                    # Fail on HIGH or CRITICAL findings.
                    trivy config \
                        --misconfig-scanners terraform \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --format table \
                        --skip-dirs .git \
                        --skip-dirs .venv \
                        --skip-dirs logs \
                        --skip-dirs .terraform \
                        --skip-dirs .ansible \
                        .

                    echo "=========================================="
                    echo "Trivy security scans passed."
                    echo "=========================================="
                '''
            }
        }

        // --------------------------------------------------
        // 4. SonarQube source-code and configuration analysis
        // --------------------------------------------------

        stage('SonarQube Analysis') {
            steps {
                script {

                    // Use the scanner installation configured in Jenkins.
                    def scannerHome = tool 'SonarScanner'

                    // Connect to the configured SonarQube server.
                    withSonarQubeEnv('SonarQube-Local') {

                        sh """
                            set -e

                            echo "Starting SonarQube analysis."

                            # Analyze the checked-out AWS AD Lab repository.
                            "${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=aws-windows-ad-lab \
                                -Dsonar.projectName="AWS Windows AD Lab" \
                                -Dsonar.projectVersion=1.0 \
                                -Dsonar.sources=. \
                                -Dsonar.sourceEncoding=UTF-8 \
                                -Dsonar.exclusions="**/.git/**,**/.venv/**,**/venv/**,**/.terraform/**,**/.ansible/**,**/logs/**,**/vault.yml,**/*.tfstate,**/*.tfstate.backup,**/*.tfplan,**/*.pem,**/*.key"

                            echo "SonarQube analysis submitted."
                        """
                    }
                }
            }
        }

        // --------------------------------------------------
        // 5. Wait for SonarQube Quality Gate
        // --------------------------------------------------

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {

                    // Require SonarQube to approve the analysis.
                    // Stop the pipeline if the Quality Gate fails.
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // --------------------------------------------------
        // 6. Manual deployment approval
        // --------------------------------------------------

        stage('Deployment Approval') {
            steps {
                script {

                    // Require approval before creating billable AWS resources.
                    input(
                        message: 'Approve deployment of Windows Server 2022 AD DS infrastructure in AWS? This deployment may create billable resources.',
                        ok: 'Approve AWS Deployment'
                    )
                }
            }
        }

        // --------------------------------------------------
        // 7. Deploy AWS infrastructure and configure AD DS
        // --------------------------------------------------

        stage('Deploy AWS Active Directory') {
            steps {

                // Retrieve AWS credentials and Ansible Vault password
                // securely from Jenkins Credentials.
                withCredentials([

                    // AWS access key ID.
                    string(
                        credentialsId: 'pumej_aws_access_id',
                        variable: 'AWS_ACCESS_KEY_ID'
                    ),

                    // AWS secret access key.
                    string(
                        credentialsId: 'pumej_aws_secret_key',
                        variable: 'AWS_SECRET_ACCESS_KEY'
                    ),

                    // Ansible Vault password file.
                    file(
                        credentialsId: 'ansible-vault-password-file',
                        variable: 'ANSIBLE_VAULT_PASSWORD_FILE'
                    )
                ]) {

                    // Verify AWS credentials before starting deployment.
                    sh '''
                        set +x

                        echo "=========================================="
                        echo "Validating AWS credentials"
                        echo "=========================================="

                        # Confirm that the Jenkins AWS credentials work.
                        aws sts get-caller-identity

                        # Confirm that the Ansible Vault password file exists.
                        test -r "$ANSIBLE_VAULT_PASSWORD_FILE"

                        echo "AWS authentication and Vault validation passed."
                    '''

                    // The Jenkins approval stage has already been completed.
                    withEnv(['JENKINS_AUTO_APPROVE=true']) {

                        sh '''
                            # Prevent shell command tracing from exposing secrets.
                            set +x
                            set -e

                            # Restrict access to the deployment script.
                            chmod 700 startupadds-aws.sh

                            echo "=========================================="
                            echo "Starting AWS Active Directory deployment"
                            echo "=========================================="

                            # Run the existing deployment automation.
                            ./startupadds-aws.sh
                        '''
                    }
                }
            }
        }

        // --------------------------------------------------
        // 8. Deployment completion
        // --------------------------------------------------

        stage('Deployment Summary') {
            steps {
                echo 'AWS Windows Server 2022 AD DS deployment completed successfully.'
                echo 'Trivy filesystem and Terraform security scans passed.'
                echo 'SonarQube Quality Gate passed.'
                echo 'Review deployment logs and Terraform outputs.'
            }
        }
    }

    // --------------------------------------------------
    // Pipeline completion and failure handling
    // --------------------------------------------------

    post {

        success {
            echo 'SUCCESS: AWS Active Directory deployment completed.'
            echo 'Trivy and SonarQube checks passed.'
        }

        failure {
            echo 'FAILED: AWS Active Directory deployment encountered an error.'
            echo 'Review the Jenkins console output and identify the failed stage.'
        }

        aborted {
            echo 'Deployment was aborted or approval was declined.'
        }

        always {
            echo 'AWS AD DS Jenkins pipeline execution finished.'
        }
    }
}
